# ===== TH79 HRM BACKEND - VPS =====
NODE_ENV=production
PORT=5000

# MongoDB local hoặc MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/hrm_th79

# BẮT BUỘC đổi thành chuỗi bí mật dài/ngẫu nhiên
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS
JWT_EXPIRES_IN=12h

# URL frontend Vercel/custom domain. Có thể khai báo nhiều URL, cách nhau bằng dấu phẩy.
CLIENT_URLS=https://YOUR-PROJECT.vercel.app

# Frontend Vercel và backend VPS là 2 origin khác nhau.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
TRUST_PROXY=1

# ===== CLOUDINARY - BẮT BUỘC CHO ẢNH/PDF/HỒ SƠ =====
# Cách 1: dùng CLOUDINARY_URL lấy từ Cloudinary Console > API Keys
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Cách 2: hoặc khai báo 3 biến riêng bên dưới.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Thư mục gốc trên Cloudinary Media Library.
CLOUDINARY_FOLDER=th79-hrm

# Link xem hồ sơ/hợp đồng authenticated có thời hạn, mặc định 5 phút.
CLOUDINARY_SIGNED_URL_TTL=300

# Chỉ còn dùng để ĐỌC/MIGRATE file local cũ. Upload mới KHÔNG ghi vào VPS.
UPLOAD_DIR=/var/www/th79-hrm-backend/uploads
